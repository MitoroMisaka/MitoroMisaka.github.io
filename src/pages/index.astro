---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/base-layout.astro';
import HeroSection from '../components/home/hero-section.astro';
import RecentWriting from '../components/home/recent-writing.astro';
import FeaturedProjects from '../components/home/featured-projects.astro';
import { getRecentPosts } from '../lib/content-helpers';

const recentPosts = await getRecentPosts(5);
const featuredProjects = await getCollection('projects', ({ data }) => data.featured);

const postItems = recentPosts.map((post) => ({
  slug: post.data.slug,
  title: post.data.title,
  date: post.data.date,
  category: post.data.category,
  description: post.data.description,
}));
---

<BaseLayout>
  <HeroSection />
  <RecentWriting posts={postItems} />
  {featuredProjects.length > 0 && <FeaturedProjects projects={featuredProjects} />}
</BaseLayout>
