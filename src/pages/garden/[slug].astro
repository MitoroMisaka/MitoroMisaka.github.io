---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PostLayout from '../../layouts/post-layout.astro';
import { formatDate } from '../../lib/content-helpers';
import { siteConfig } from '../../lib/site-config';
import { computeBacklinks } from '../../lib/garden';

export async function getStaticPaths() {
  const entries = await getCollection('garden', ({ data }) => !data.draft);
  const backlinks = await computeBacklinks();

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, backlinks },
  }));
}

type Props = {
  entry: CollectionEntry<'garden'>;
  backlinks: Map<string, string[]>;
};

const { entry, backlinks } = Astro.props as Props;
const { Content } = await render(entry);
const { data } = entry;

const stageEmoji: Record<string, string> = {
  seedling: '🌱',
  budding: '🌿',
  evergreen: '🌳',
};

const stageLabel: Record<string, string> = {
  seedling: '嫩芽',
  budding: '生长中',
  evergreen: '长青',
};

const displayDate = data.updated ?? data.date;

// Related entries (from frontmatter `related` field)
let relatedEntries: CollectionEntry<'garden'>[] = [];
if (data.related.length > 0) {
  const allEntries = await getCollection('garden', ({ data: d }) => !d.draft);
  const relatedSet = new Set(data.related);
  relatedEntries = allEntries.filter((e) => relatedSet.has(e.id));
}

// Backlinks for this entry
const entryBacklinks = backlinks.get(entry.id) ?? [];
let backlinkEntries: CollectionEntry<'garden'>[] = [];
if (entryBacklinks.length > 0) {
  const allEntries = await getCollection('garden', ({ data: d }) => !d.draft);
  const blSet = new Set(entryBacklinks);
  backlinkEntries = allEntries.filter((e) => blSet.has(e.id));
}
---

<PostLayout
  title={`${data.title} | ${siteConfig.title}`}
  description={data.description}
  canonicalPath={`/garden/${entry.id}`}
>
  <header class="space-y-3">
    <a
      href="/garden"
      class="text-label-12 text-neutral-7 hover:text-neutral-9 transition"
    >
      ←  Garden
    </a>
    <h1 class="text-title-28 font-medium leading-tight md:text-display-48">{data.title}</h1>
    <p class="text-label-12 text-neutral-7">{data.description}</p>
    <div class="flex flex-wrap items-center gap-2 text-caption-10 text-neutral-7">
      <span class="inline-flex items-center gap-1 rounded-full border border-neutral-3 px-2 py-0.5">
        {stageEmoji[data.stage]} {stageLabel[data.stage]}
      </span>
      <span>·</span>
      <span>{data.category}</span>
      <span>·</span>
      <time>{formatDate(displayDate)}</time>
    </div>
    {data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 pt-1">
        {data.tags.map((tag: string) => (
          <span class="rounded-full border border-neutral-3 px-2 py-0.5 text-caption-10 text-neutral-7">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </header>

  <div class="prose max-w-none mt-8">
    <Content />
  </div>

  <!-- Related entries -->
  {
    relatedEntries.length > 0 && (
      <section class="mt-10 border-t border-neutral-3 pt-6">
        <h2 class="text-copy-16 font-medium">关联条目</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {relatedEntries.map((re) => (
            <a
              href={`/garden/${re.id}`}
              class="rounded-lg border border-neutral-3 px-3 py-1.5 text-label-12 text-neutral-7 hover:border-neutral-4 hover:text-neutral-9 transition"
            >
              {re.data.title}
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Backlinks -->
  {
    backlinkEntries.length > 0 && (
      <section class="mt-6 border-t border-neutral-3 pt-6">
        <h2 class="text-copy-16 font-medium">哪些页面引用了本文</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {backlinkEntries.map((be) => (
            <a
              href={`/garden/${be.id}`}
              class="rounded-lg border border-neutral-3 px-3 py-1.5 text-label-12 text-neutral-7 hover:border-neutral-4 hover:text-neutral-9 transition"
            >
              {be.data.title}
            </a>
          ))}
        </div>
      </section>
    )
  }
</PostLayout>
