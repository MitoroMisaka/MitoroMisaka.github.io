---
import BaseLayout from '../layouts/base-layout.astro';
import { siteConfig } from '../lib/site-config';
import { getCollection } from 'astro:content';
import GardenFilter from '../components/garden/garden-filter';

const entries = await getCollection('garden', ({ data }) => !data.draft);

// Flatten for the React island (avoid passing Astro CollectionEntry objects)
const flatEntries = entries.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  category: entry.data.category,
  stage: entry.data.stage,
  tags: entry.data.tags,
  updated: (entry.data.updated ?? entry.data.date).toISOString().split('T')[0] ?? '',
}));
---

<BaseLayout
  title={` Garden | ${siteConfig.title}`}
  description="Digital Garden — 知识库。记录想法、概念和技术笔记，随时间生长。"
  canonicalPath="/garden"
>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <header class="mb-10">
      <h1 class="text-title-28 font-medium md:text-display-48"> Garden</h1>
      <p class="mt-2 text-neutral-7">
        Digital Garden — 想法和知识随时间生长的空间。
        🌱 嫩芽（初始想法）→ 🌿 生长中 → 🌳 长青（成熟稳定）
      </p>
    </header>

    {
      entries.length === 0 ? (
        <div class="rounded-xl border border-dashed border-neutral-3 px-8 py-16 text-center">
          <p class="text-copy-16 text-neutral-7">Garden 尚未播种 🌱</p>
          <p class="mt-2 text-label-12 text-neutral-7">
            当有新的知识条目后，会在这里按分类展示。
          </p>
        </div>
      ) : (
        <GardenFilter entries={flatEntries} client:load />
      )
    }
  </main>
</BaseLayout>
