---
import BaseLayout from '../layouts/base-layout.astro';
import { siteConfig } from '../lib/site-config';
import { getCollection } from 'astro:content';
import GardenCard from '../components/garden/garden-card.astro';

const entries = await getCollection('garden', ({ data }) => !data.draft);

// Group by category
const groups = new Map<string, typeof entries>();
for (const entry of entries) {
  const cat = entry.data.category;
  if (!groups.has(cat)) groups.set(cat, []);
  groups.get(cat)!.push(entry);
}

// Sort entries within each group by date desc
for (const [, groupEntries] of groups) {
  groupEntries.sort((a, b) => {
    const aDate = a.data.updated ?? a.data.date;
    const bDate = b.data.updated ?? b.data.date;
    return bDate.getTime() - aDate.getTime();
  });
}
---

<BaseLayout
  title={` Garden | ${siteConfig.title}`}
  description="Digital Garden — 知识库。记录想法、概念和技术笔记，随时间生长。"
  canonicalPath="/garden"
>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <header class="mb-10">
      <h1 class="text-3xl font-semibold md:text-4xl"> Garden</h1>
      <p class="mt-2 text-[var(--fg-muted)]">
        Digital Garden — 想法和知识随时间生长的空间。
        🌱 嫩芽（初始想法）→ 🌿 生长中 → 🌳 长青（成熟稳定）
      </p>
    </header>

    {
      entries.length === 0 ? (
        <div class="rounded-xl border border-dashed border-[var(--line)] px-8 py-16 text-center">
          <p class="text-lg text-[var(--fg-muted)]">Garden 尚未播种 🌱</p>
          <p class="mt-2 text-sm text-[var(--fg-soft)]">
            当有新的知识条目后，会在这里按分类展示。
          </p>
        </div>
      ) : (
        [...groups.entries()].map(([category, groupEntries]) => (
          <section class="mb-10">
            <h2 class="mb-4 text-xl font-semibold">{category}</h2>
            <div class="grid gap-4 sm:grid-cols-2">
              {groupEntries.map((entry) => (
                <GardenCard entry={entry} />
              ))}
            </div>
          </section>
        ))
      )
    }
  </main>
</BaseLayout>
