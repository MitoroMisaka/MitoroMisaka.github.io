---
import BaseLayout from '../../layouts/base-layout.astro';
import { getPublishedPosts, formatDate } from '../../lib/content-helpers';

const posts = await getPublishedPosts();
---

<BaseLayout title="文章 | 静かな森" description="技术文章与开发随笔。">
  <section class="space-y-6">
    <h1 class="text-3xl font-semibold">文章</h1>
    <ol class="space-y-3">
      {posts.map((post) => (
        <li class="rounded-2xl border border-[var(--line)] bg-[var(--card)] px-4 py-4">
          <a class="block" href={`/posts/${post.data.slug}`}>
            <h2 class="text-lg font-medium">{post.data.title}</h2>
            <p class="mt-2 text-sm text-[var(--fg-muted)]">{post.data.description}</p>
            <div class="mt-3 flex items-center gap-2 text-xs text-[var(--fg-soft)]">
              <span>{post.data.category}</span>
              <span>·</span>
              <time>{formatDate(post.data.date)}</time>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
