---
import BaseLayout from '../../layouts/base-layout.astro';
import { getPublishedPosts, formatDate, getAllTags } from '../../lib/content-helpers';

const posts = await getPublishedPosts();
const tags = await getAllTags();

const pinnedPosts = posts.filter((p) => p.data.pinned);
const regularPosts = posts.filter((p) => !p.data.pinned);
---

<BaseLayout title="文章 | 静かな森" description="技术文章与开发随笔。">
  <div class="lg:flex lg:gap-12">
    <!-- 主内容区 -->
    <section class="flex-1 min-w-0">
      <!-- 页面头部 -->
      <header class="mb-10">
        <p class="text-caption-10 uppercase tracking-[0.2em] text-neutral-7">BLOG</p>
        <h1 class="text-title-28 font-medium">文章</h1>
        <p class="mt-1 text-label-12 text-neutral-7">共 {posts.length} 篇</p>
      </header>

      <!-- 置顶文章 -->
      {pinnedPosts.length > 0 && (
        <div class="mb-10 space-y-6">
          {pinnedPosts.map((post) => (
            <a href={`/posts/${post.data.slug}`} class="block group border-l-[3px] border-l-accent pl-4">
              <div class="flex items-center gap-2">
                <span class="text-caption-10 text-accent bg-accent/10 px-1 rounded">置顶</span>
                <h2 class="text-title-20 font-medium group-hover:text-accent transition-colors">{post.data.title}</h2>
              </div>
              {post.data.description && (
                <p class="mt-2 text-copy-14 text-neutral-7 line-clamp-2 max-w-[65ch]">{post.data.description}</p>
              )}
              <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-label-12 text-neutral-7">
                <time>{formatDate(post.data.date)}</time>
                {post.data.updated && post.data.updated.getTime() !== post.data.date.getTime() && (
                  <span>(已编辑)</span>
                )}
                <span>·</span>
                <span>{post.data.category}</span>
                {post.data.tags.length > 0 && (
                  <>
                    <span>/</span>
                    <span class="flex flex-wrap gap-1">
                      {post.data.tags.map((tag: string, i: number) => (
                        <>
                          {i > 0 && <span>,</span>}
                          <a href={`/tags/${tag}`} class="text-label-12 text-accent hover:underline">{tag}</a>
                        </>
                      ))}
                    </span>
                  </>
                )}
              </div>
            </a>
          ))}
        </div>
      )}

      <!-- 普通文章列表 -->
      {regularPosts.length > 0 && (
        <ol class="space-y-8">
          {regularPosts.map((post) => (
            <li>
              <a href={`/posts/${post.data.slug}`} class="block group">
                <h2 class="text-title-20 font-medium group-hover:text-accent transition-colors">{post.data.title}</h2>
                {post.data.description && (
                  <div class="mt-2 ring-1 ring-accent/10 rounded-md px-4 py-2">
                    <p class="text-copy-14 text-neutral-7 line-clamp-2 max-w-[65ch]">{post.data.description}</p>
                  </div>
                )}
                <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-label-12 text-neutral-7">
                  <time>{formatDate(post.data.date)}</time>
                  {post.data.updated && post.data.updated.getTime() !== post.data.date.getTime() && (
                    <span>(已编辑)</span>
                  )}
                  <span>·</span>
                  <span>{post.data.category}</span>
                  {post.data.tags.length > 0 && (
                    <>
                      <span>/</span>
                      <span class="flex flex-wrap gap-1">
                        {post.data.tags.map((tag: string, i: number) => (
                          <>
                            {i > 0 && <span>,</span>}
                            <a href={`/tags/${tag}`} class="text-label-12 text-accent hover:underline">{tag}</a>
                          </>
                        ))}
                      </span>
                    </>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ol>
      )}

      {posts.length === 0 && (
        <div class="py-10 text-center text-label-12 text-neutral-7">暂无文章</div>
      )}
    </section>

    <!-- 右侧标签云 -->
    {tags.size > 0 && (
      <aside class="mt-12 lg:mt-0 lg:w-56 shrink-0">
        <h3 class="text-label-12 text-neutral-7 mb-3">标签云</h3>
        <div class="flex flex-wrap gap-1.5">
          {[...tags.entries()].map(([tag, count]) => (
            <a
              href={`/tags/${tag}`}
              class="text-label-12 border border-neutral-3 rounded-full px-2 py-0.5 hover:border-accent hover:text-accent transition"
            >
              {tag} ({count})
            </a>
          ))}
        </div>
      </aside>
    )}
  </div>
</BaseLayout>
