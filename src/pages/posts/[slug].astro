---
import { render } from 'astro:content';
import PostLayout from '../../layouts/post-layout.astro';
import { formatDate, getPublishedPosts } from '../../lib/content-helpers';
import { siteConfig } from '../../lib/site-config';
import TableOfContents from '../../components/post/table-of-contents';
import ReadingProgress from '../../components/post/reading-progress';
import GiscusComments from '../../components/post/giscus-comments';
import ReactionBar from '../../components/ui/reaction-bar';
import SeriesIndicator from '../../components/series/series-indicator.astro';
import SeriesNav from '../../components/series/series-nav.astro';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, idx) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      prev: idx > 0 ? posts[idx - 1] : null,
      next: idx < posts.length - 1 ? posts[idx + 1] : null,
    },
  }));
}

interface NavPost {
  data: { title: string; slug: string };
}

const { post, prev, next } = Astro.props as { post: any; prev: NavPost | null; next: NavPost | null };
const { Content } = await render(post);

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 300));
---

<PostLayout title={`${post.data.title} | ${siteConfig.title}`} description={post.data.description} canonicalPath={`/posts/${post.data.slug}`}>
  <ReadingProgress client:load />
  <TableOfContents client:load />
  <header class="space-y-3">
    <SeriesIndicator post={post} />
    <h1 class="text-title-28 font-medium leading-tight md:text-display-48">{post.data.title}</h1>
    <p class="text-label-12 text-neutral-7">{post.data.description}</p>
    <div class="flex flex-wrap items-center gap-2 text-caption-10 text-neutral-7">
      <a href={`/categories/${post.data.category}`} class="hover:text-neutral-9">{post.data.category}</a>
      <span>·</span>
      <time>{formatDate(post.data.date)}</time>
      <span>·</span>
      <span>{readingTime} min read</span>
    </div>
    {post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 pt-1">
        {post.data.tags.map((tag: string) => (
          <a href={`/tags/${tag}`} class="rounded-full border border-neutral-3 px-2 py-0.5 text-caption-10 text-neutral-7 hover:bg-neutral-1">
            #{tag}
          </a>
        ))}
      </div>
    )}
  </header>
  <div class="prose max-w-none mt-8">
    <Content />
  </div>

  <SeriesNav post={post} />

  <nav class="mt-10 grid grid-cols-2 gap-4 border-t border-neutral-3 pt-6">
    {prev ? (
      <a href={`/posts/${prev.data.slug}`} class="rounded-xl border border-neutral-3 px-4 py-3 text-left transition hover:border-neutral-4">
        <span class="text-caption-10 text-neutral-7">← 上一篇</span>
        <p class="mt-1 text-label-12 font-medium text-neutral-9 line-clamp-1">{prev.data.title}</p>
      </a>
    ) : <div />}
    {next ? (
      <a href={`/posts/${next.data.slug}`} class="rounded-xl border border-neutral-3 px-4 py-3 text-right transition hover:border-neutral-4">
        <span class="text-caption-10 text-neutral-7">下一篇 →</span>
        <p class="mt-1 text-label-12 font-medium text-neutral-9 line-clamp-1">{next.data.title}</p>
      </a>
    ) : <div />}
  </nav>

  <GiscusComments client:load />
  <ReactionBar target={`post:${post.data.slug}`} client:load />
</PostLayout>
