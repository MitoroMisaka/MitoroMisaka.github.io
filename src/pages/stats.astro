---
import BaseLayout from '../layouts/base-layout.astro';
import StatsDashboard from '../components/stats/stats-dashboard';
---

<BaseLayout title="数据 | 静かな森" description="隐私友好的聚合统计，不追踪个人身份。">
  <section class="mx-auto max-w-3xl space-y-8">
    <header class="space-y-2">
      <h1 class="text-title-28 font-medium">站点数据</h1>
      <p class="text-neutral-7">
        隐私友好的聚合统计，不追踪个人身份。
      </p>
    </header>

    <StatsDashboard client:load />

    <footer class="border-t border-neutral-3 pt-6 text-caption-10 text-neutral-7 leading-relaxed">
      <p>数据基于页面浏览事件聚合，每日更新，可能有数分钟延迟。</p>
      <p>不存储 IP、User-Agent 或任何个人可识别信息。</p>
    </footer>
  </section>
</BaseLayout>
