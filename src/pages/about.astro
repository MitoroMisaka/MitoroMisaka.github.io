---
import BaseLayout from '../layouts/base-layout.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = '关于 | 静かな森', description = '关于 MitoroMisaka 与这个站点。' } = Astro.props as Props;
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-3xl space-y-8">
    <h1 class="text-title-28 font-medium">关于</h1>

    <p class="text-copy-14 text-neutral-7">
      这里记录我与 AI Agent 协作开发的实践经验，包括文档驱动开发、工作流沉淀与技术实现。
    </p>
    <p class="text-copy-14 text-neutral-7">
      站点正在从旧 Jekyll 架构迁移到 Astro + Cloudflare Pages，后续会持续完善文章系统、时间线与碎念模块。
    </p>

    <!-- 名字由来 -->
    <details class="group">
      <summary class="cursor-pointer list-none text-label-12 font-medium text-neutral-9 hover:text-accent transition-colors">
        <span class="mr-1 text-caption-10 text-neutral-7 group-open:rotate-90 inline-block transition-transform">▶</span>
        名字由来
      </summary>
      <div class="mt-3 ml-5 space-y-2 text-copy-14 text-neutral-7">
        <p>MitoroMisaka 源自日语「見通し」与「御坂」：</p>
        <ul class="list-disc list-inside space-y-1">
          <li><strong>見通し（みとおし）</strong>：展望、预见。希望自己能看清技术的前路。</li>
          <li><strong>御坂（みさか）</strong>：致敬《某科学的超电磁炮》角色御坂美琴。</li>
        </ul>
      </div>
    </details>

    <!-- 设备 -->
    <details class="group">
      <summary class="cursor-pointer list-none text-label-12 font-medium text-neutral-9 hover:text-accent transition-colors">
        <span class="mr-1 text-caption-10 text-neutral-7 group-open:rotate-90 inline-block transition-transform">▶</span>
        设备
      </summary>
      <div class="mt-3 ml-5 text-copy-14 text-neutral-7">
        <ul class="list-disc list-inside space-y-1">
          <li>MacBook Pro M4 Pro</li>
          <li>iPhone 15 Pro</li>
          <li>iPad Pro M4</li>
        </ul>
      </div>
    </details>
  </section>
</BaseLayout>
