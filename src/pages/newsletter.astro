---
import BaseLayout from '../layouts/base-layout.astro';

const pageTitle = '订阅 | 静かな森';
const pageDesc = '通过 RSS 阅读器订阅博客更新。';
---

<BaseLayout title={pageTitle} description={pageDesc} canonicalPath="/subscribe">
  <section class="mx-auto max-w-3xl space-y-6">
    <h1 class="text-3xl font-semibold">订阅</h1>
    <p class="text-neutral-7">通过 RSS 阅读器订阅博客更新，无需注册、无需邮箱。</p>

    <div class="space-y-2 rounded-2xl border border-neutral-3 bg-neutral-1 p-6">
      <h2 class="text-lg font-medium">RSS Feed</h2>
      <p class="text-sm text-neutral-7">
        将以下链接添加到你的 RSS 阅读器，即可在发布新文章时自动收到更新。
      </p>
      <div class="flex flex-col gap-2 pt-2">
        <a href="/rss.xml" class="rounded-xl border border-neutral-3 px-4 py-3 text-sm hover:bg-neutral-1 transition">
          <span class="font-medium text-neutral-9">正式文章</span>
          <span class="ml-2 text-neutral-7">/rss.xml</span>
          <p class="mt-1 text-xs text-neutral-7">所有正式技术文章更新。</p>
        </a>
        <a href="/notes.xml" class="rounded-xl border border-neutral-3 px-4 py-3 text-sm hover:bg-neutral-1 transition">
          <span class="font-medium text-neutral-9">碎念</span>
          <span class="ml-2 text-neutral-7">/notes.xml</span>
          <p class="mt-1 text-xs text-neutral-7">短想法、开发随笔、AI 工作流记录。</p>
        </a>
      </div>
    </div>

    <div class="space-y-2 text-sm text-neutral-7">
      <h2 class="text-base font-medium text-neutral-9">推荐阅读器</h2>
      <ul class="list-disc pl-5 space-y-1">
        <li><a href="https://netnewswire.com/" class="hover:text-neutral-9 underline">NetNewsWire</a> — macOS / iOS，免费开源</li>
        <li><a href="https://reederapp.com/" class="hover:text-neutral-9 underline">Reeder</a> — macOS / iOS，设计精美</li>
        <li><a href="https://feedly.com/" class="hover:text-neutral-9 underline">Feedly</a> — Web / 全平台，免费计划够用</li>
        <li><a href="https://www.inoreader.com/" class="hover:text-neutral-9 underline">Inoreader</a> — Web / 全平台</li>
      </ul>
    </div>

    <p class="text-xs text-neutral-7 pt-4 border-t border-neutral-3">
      RSS 是一种开放的订阅协议，无需登录、无需提供个人信息。用 RSS 阅读器订阅后，新文章会自动出现在你的阅读器里。
    </p>
  </section>
</BaseLayout>
