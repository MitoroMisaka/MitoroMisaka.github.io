---
import { render } from 'astro:content';
import PostLayout from '../../layouts/post-layout.astro';
import { formatDate, getPublishedNotes } from '../../lib/content-helpers';
import { getMoodLabel } from '../../lib/mood-labels';
import { siteConfig } from '../../lib/site-config';
import ReactionBar from '../../components/ui/reaction-bar';
import ShareButton from '../../components/notes/share-button';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return notes.map((note) => ({
    params: { slug: note.data.slug },
    props: { note },
  }));
}

const { note } = Astro.props as { note: any };
const { Content } = await render(note);

const title = note.data.title ?? note.data.slug;
const description = note.data.description ?? '';

const wordCount = note.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 300));
---

<PostLayout title={`${title} | 碎念 | ${siteConfig.title}`} description={description} canonicalPath={`/notes/${note.data.slug}`}>
  <header class="space-y-3">
    <div class="flex items-center gap-3 text-xs text-[var(--fg-soft)]">
      <a href="/notes" class="hover:text-[var(--fg)]">← 碎念列表</a>
    </div>
    {note.data.title ? (
      <h1 class="text-3xl font-semibold leading-tight md:text-4xl">{note.data.title}</h1>
    ) : (
      <h1 class="text-2xl font-medium text-[var(--fg-muted)] italic">无标题碎念</h1>
    )}
    {note.data.description && (
      <p class="text-sm text-[var(--fg-muted)]">{note.data.description}</p>
    )}
    <div class="flex flex-wrap items-center gap-2 text-xs text-[var(--fg-soft)]">
      <time>{formatDate(note.data.date)}</time>
      <span>·</span>
      <span>{readingTime} min read</span>
      {note.data.mood && (
        <>
          <span>·</span>
          <span>{getMoodLabel(note.data.mood)}</span>
        </>
      )}
    </div>
    {note.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 pt-1">
        {note.data.tags.map((tag: string) => (
          <a
            href={`/tags/${tag}`}
            class="rounded-full border border-[var(--line)] px-2 py-0.5 text-xs text-[var(--fg-muted)] hover:bg-[var(--card)]"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}
  </header>

  <div class="prose prose-zinc max-w-none dark:prose-invert mt-8">
    <Content />
  </div>

  <ShareButton title={title} client:idle />

  <ReactionBar target={`note:${note.data.slug}`} client:load />
</PostLayout>
