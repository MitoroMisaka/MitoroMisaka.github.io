---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/base-layout.astro';

const thinkings = await getCollection('thinking', ({ data }) => !data.draft);
thinkings.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function relativeDate(d: Date): string {
  const now = new Date();
  const ms = now.getTime() - d.getTime();
  const days = Math.floor(ms / (1000 * 60 * 60 * 24));
  if (days === 0) return '今天';
  if (days === 1) return '昨天';
  if (days < 7) return `${days} 天前`;
  const weeks = Math.floor(days / 7);
  if (weeks < 5) return `${weeks} 周前`;
  const months = Math.floor(days / 30);
  if (months < 12) return `${months} 个月前`;
  return `${Math.floor(days / 365)} 年前`;
}
---

<BaseLayout title="思考 | 静かな森" description="感君倾耳。">
  <section class="mx-auto max-w-3xl">
    <header>
      <h1 class="text-title-28 font-medium">思考</h1>
      <p class="text-copy-14 text-neutral-7">感君倾耳。</p>
    </header>

    <div class="mt-10 space-y-6">
      {thinkings.length === 0 && (
        <p class="text-copy-14 text-neutral-7">还没有思考内容。</p>
      )}
      {thinkings.map((entry) => (
        <article class="flex gap-4">
          <img
            src="/avatar.png"
            alt="MitoroMisaka"
            class="size-10 rounded-full shrink-0"
            onerror="this.style.display='none'"
          />
          <div class="min-w-0 flex-1">
            <p class="text-label-12 font-medium">
              MitoroMisaka · <span class="text-caption-10 text-neutral-7">{relativeDate(entry.data.date)}</span>
            </p>
            <div class="mt-2">
              <h2 class="text-copy-14 font-medium text-neutral-9">
                {entry.data.title}
              </h2>
              {entry.body && (
                <div class="mt-1 text-copy-14 text-neutral-7 line-clamp-3">
                  {entry.body}
                </div>
              )}
            </div>
            <div class="mt-3 flex gap-4 text-label-12 text-neutral-7">
              <button disabled class="cursor-default">👍 喜欢 0</button>
              <button disabled class="cursor-default">💬 评论 0</button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
