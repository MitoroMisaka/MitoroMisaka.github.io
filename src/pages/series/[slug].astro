---
import BaseLayout from '../../layouts/base-layout.astro';
import { siteConfig } from '../../lib/site-config';
import { getSeriesList, getPostsInSeries, formatDate } from '../../lib/content-helpers';
import { getSeriesConfig } from '../../lib/series-config';

export async function getStaticPaths() {
  const seriesMap = await getSeriesList();
  return [...seriesMap.keys()].map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const config = getSeriesConfig(slug as string);
const posts = await getPostsInSeries(slug as string);
const seriesTitle = config?.name ?? slug;
const description = config?.description ?? '';
---

<BaseLayout
  title={`${seriesTitle} | ${siteConfig.title}`}
  description={description || `${seriesTitle} 系列文章`}
>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <header class="mb-10">
      <a
        href="/series"
        class="text-label-12 text-neutral-7 hover:text-neutral-9 transition"
      >
        ← 系列文章
      </a>
      <h1 class="mt-3 text-title-28 font-medium md:text-display-48">{seriesTitle}</h1>
      {description && (
        <p class="mt-2 text-neutral-7">{description}</p>
      )}
      <div class="mt-3 flex items-center gap-2 text-label-12">
        <span class="inline-flex items-center rounded-full bg-accent/10 px-3 py-0.5 text-caption-10 font-medium text-accent">
          {posts.length} 篇已完成
        </span>
      </div>
    </header>

    {
      posts.length === 0 ? (
        <div class="rounded-xl border border-dashed border-neutral-3 px-8 py-16 text-center">
          <p class="text-copy-16 text-neutral-7">该系列暂无文章</p>
        </div>
      ) : (
        <div class="space-y-3">
          {posts.map((post) => (
            <a
              href={`/posts/${post.data.slug}`}
              class="group flex items-start gap-4 rounded-xl border border-neutral-3 p-4 transition hover:border-neutral-4"
            >
              {post.data.seriesOrder != null && (
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent/10 text-caption-10 font-medium text-accent">
                  {post.data.seriesOrder}
                </span>
              )}
              <div class="min-w-0 flex-1">
                <h2 class="font-medium group-hover:text-accent transition-colors line-clamp-1">
                  {post.data.title}
                </h2>
                <p class="mt-1 text-label-12 text-neutral-7 line-clamp-2">
                  {post.data.description}
                </p>
                <div class="mt-2 flex flex-wrap items-center gap-2 text-caption-10 text-neutral-7">
                  <time>{formatDate(post.data.date)}</time>
                  {post.data.tags.slice(0, 3).map((tag: string) => (
                    <span class="rounded-full border border-neutral-3 px-2 py-0.5">
                      #{tag}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </main>
</BaseLayout>
