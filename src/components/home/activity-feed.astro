---
import type { ActivityItem } from '../../lib/activity-feed';
import { getActivityFeed } from '../../lib/activity-feed';

interface Props {
  feed?: ActivityItem[];
  limit?: number;
}

const feed = (Astro.props as Props).feed ?? await getActivityFeed((Astro.props as Props).limit ?? 10);

function relativeDate(d: Date): string {
  const now = new Date();
  const ms = now.getTime() - d.getTime();
  const sec = Math.floor(ms / 1000);
  const min = Math.floor(sec / 60);
  const hours = Math.floor(min / 60);
  const days = Math.floor(hours / 24);
  const weeks = Math.floor(days / 7);
  const months = Math.floor(days / 30);

  if (days === 0) return '今天';
  if (days === 1) return '昨天';
  if (days < 7) return `${days} 天前`;
  if (weeks < 5) return `${weeks} 周前`;
  if (months < 12) return `${months} 个月前`;
  return `${Math.floor(days / 365)} 年前`;
}

const emojiMap: Record<string, string> = {
  post: '📝',
  note: '💭',
  garden: '🌱',
  project: '🚀',
};

const actionMap: Record<string, Record<string, string>> = {
  post: { created: '发布了新文章', updated: '更新了文章' },
  note: { created: '发布了碎念', updated: '更新了碎念' },
  garden: { created: '种下了 Garden', updated: '养护了 Garden' },
  project: { created: '新增了项目', updated: '更新了项目' },
};
---

<section class="mt-12">
  <h2 class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-[var(--fg-soft)]">
    最近动态
  </h2>
  <div class="space-y-2">
    {feed.map((item: ActivityItem) => (
      <a
        href={item.url}
        class="flex items-start gap-3 rounded-lg px-3 py-2 transition hover:bg-[var(--card)]"
      >
        <span class="mt-0.5 flex-shrink-0 text-base leading-none" role="img" aria-label={item.type}>
          {emojiMap[item.type] ?? '📌'}
        </span>
        <div class="min-w-0 flex-1">
          <span class="text-sm text-[var(--fg)]">
            {actionMap[item.type]?.[item.action] ?? '更新了'}
            <span class="font-medium">「{item.title}」</span>
          </span>
        </div>
        <span class="flex-shrink-0 text-xs text-[var(--fg-soft)]">
          {relativeDate(item.date)}
        </span>
      </a>
    ))}
    {feed.length === 0 && (
      <p class="text-sm text-[var(--fg-soft)]">还没有动态。</p>
    )}
  </div>
</section>
