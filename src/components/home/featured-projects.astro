---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section class="mt-14">
  <h2 class="mb-4 text-xl font-semibold">Projects</h2>
  <div class="grid gap-4 md:grid-cols-2">
    {projects.map((project) => (
      <article class="rounded-2xl border border-[var(--line)] bg-[var(--card)] px-4 py-4">
        <h3 class="text-base font-medium">{project.data.name}</h3>
        <p class="mt-2 text-sm text-[var(--fg-muted)]">{project.data.description}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {project.data.tags.map((tag) => (
            <span class="rounded-full border border-[var(--line)] px-2 py-0.5 text-xs text-[var(--fg-muted)]">#{tag}</span>
          ))}
        </div>
        <div class="mt-4 flex items-center gap-4 text-sm">
          {project.data.repo && (
            <a class="text-[var(--fg-muted)] hover:text-[var(--fg)]" href={project.data.repo}>GitHub</a>
          )}
          {project.data.demo && (
            <a class="text-[var(--fg-muted)] hover:text-[var(--fg)]" href={project.data.demo}>Demo</a>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
