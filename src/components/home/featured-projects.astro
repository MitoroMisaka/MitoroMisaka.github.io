---
import type { CollectionEntry } from 'astro:content';
import { getProjectSlug } from '../../lib/content-helpers';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section class="mt-14">
  <h2 class="mb-4 text-xl font-semibold">Projects</h2>
  <div class="grid gap-4 md:grid-cols-2">
    {projects.map((project) => {
      const projectSlug = getProjectSlug(project);
      return (
        <article class="rounded-2xl border border-neutral-3 bg-neutral-1 px-4 py-4 transition hover:border-neutral-4">
          <a href={`/projects/${projectSlug}`} class="block">
            <h3 class="text-base font-medium">{project.data.name}</h3>
            <p class="mt-2 text-label-12 text-neutral-7">{project.data.description}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {project.data.tags.map((tag) => (
                <span class="rounded-full border border-neutral-3 px-2 py-0.5 text-caption-10 text-neutral-7">#{tag}</span>
              ))}
            </div>
          </a>
          <div class="mt-4 flex items-center gap-4 text-label-12">
            {project.data.repo && (
              <a class="text-neutral-7 hover:text-neutral-9" href={project.data.repo}>GitHub</a>
            )}
            {project.data.demo && (
              <a class="text-neutral-7 hover:text-neutral-9" href={project.data.demo}>Demo</a>
            )}
          </div>
        </article>
      );
    })}
  </div>
</section>
