---
import { siteConfig } from '../../lib/site-config';
---

<section class="space-y-6 pt-4 md:pt-8">
  <div class="space-y-3">
    <p class="text-sm uppercase tracking-[0.2em] text-[var(--fg-soft)]">Shizukana Mori</p>
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">{siteConfig.title}</h1>
    <p class="text-base text-[var(--fg-muted)] md:text-lg">{siteConfig.hero.subtitle}</p>
  </div>

  <blockquote class="rounded-2xl border border-[var(--line)] bg-[var(--card)] px-4 py-4 text-sm text-[var(--fg-muted)]">
    {siteConfig.hero.quote}
  </blockquote>

  <div class="flex flex-wrap gap-3 text-sm">
    {siteConfig.social.map((item) => (
      <a href={item.href} class="rounded-full border border-[var(--line)] px-3 py-1.5 text-[var(--fg-muted)] transition hover:bg-[var(--card)] hover:text-[var(--fg)]">
        {item.label}
      </a>
    ))}
  </div>
</section>
