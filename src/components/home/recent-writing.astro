---
import { formatDate } from '../../lib/content-helpers';

interface PostPreview {
  slug: string;
  title: string;
  date: Date;
  category: string;
  description?: string;
}

interface Props {
  posts: PostPreview[];
}

const { posts } = Astro.props;
---

<section class="mt-16">
  <div class="mb-6 flex items-end justify-between">
    <h2 class="text-xl font-semibold">Recent Writing</h2>
    <a class="text-sm text-[var(--fg-muted)] hover:text-[var(--fg)]" href="/posts">查看全部</a>
  </div>

  <ol class="space-y-4">
    {posts.map((post, index) => (
      <li class="group rounded-2xl border border-[var(--line)] bg-[var(--card)] px-5 py-5 transition hover:border-[var(--line-strong)]">
        <a href={`/posts/${post.slug}`} class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
          <div class="flex items-start gap-4">
            <span class="mt-0.5 text-xs tabular-nums text-[var(--fg-soft)]">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <p class="text-base font-medium leading-snug transition-colors group-hover:text-[var(--brand)]">{post.title}</p>
              {post.description && (
                <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)] line-clamp-2">{post.description}</p>
              )}
              <div class="mt-2 flex items-center gap-2 text-xs">
                <span class="text-[var(--fg-soft)]">{post.category}</span>
                <span class="text-[var(--fg-soft)]">·</span>
                <time class="text-[var(--fg-soft)]">{formatDate(post.date)}</time>
              </div>
            </div>
          </div>
        </a>
      </li>
    ))}
  </ol>
</section>
