---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../lib/content-helpers';

interface Props {
  entry: CollectionEntry<'garden'>;
}

const { entry } = Astro.props;
const { data } = entry;

const stageEmoji: Record<string, string> = {
  seedling: '🌱',
  budding: '🌿',
  evergreen: '🌳',
};

const stageLabel: Record<string, string> = {
  seedling: '嫩芽',
  budding: '生长中',
  evergreen: '长青',
};

const displayDate = data.updated ?? data.date;
---

<a
  href={`/garden/${entry.id}`}
  class="group block rounded-xl border border-neutral-3 p-5 transition hover:border-neutral-4 hover:shadow-sm"
>
  <div class="flex items-start justify-between gap-2">
    <h3 class="text-copy-16 font-medium group-hover:text-accent transition-colors line-clamp-1">
      {data.title}
    </h3>
    <span
      class="inline-flex shrink-0 items-center gap-1 rounded-full border border-neutral-3 px-2 py-0.5 text-caption-10 text-neutral-7"
      title={stageLabel[data.stage]}
    >
      {stageEmoji[data.stage]} {stageLabel[data.stage]}
    </span>
  </div>

  <p class="mt-2 text-label-12 text-neutral-7 line-clamp-2">
    {data.description}
  </p>

  <div class="mt-3 flex flex-wrap items-center gap-3 text-caption-10 text-neutral-7">
    {data.tags.length > 0 && (
      <span>{data.tags.map((t: string) => `#${t}`).join(' ')}</span>
    )}
    <span>{formatDate(displayDate)}</span>
  </div>
</a>
