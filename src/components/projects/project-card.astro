---
import type { CollectionEntry } from 'astro:content';
import { getProjectSlug } from '../../lib/content-helpers';

interface Props {
  project: CollectionEntry<'projects'>;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const projectSlug = getProjectSlug(project);
const { name, description, status, stack, tags, repo, demo, links } = project.data;

const statusLabels: Record<string, string> = {
  active: '进行中',
  archived: '已归档',
  planned: '计划中',
};

const statusColors: Record<string, string> = {
  active: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400',
  archived: 'bg-zinc-500/10 text-zinc-500',
  planned: 'bg-amber-500/10 text-amber-600 dark:text-amber-400',
};
---

<article class="rounded-2xl border border-neutral-3 bg-neutral-1 px-5 py-4 transition hover:border-neutral-4">
  <a href={`/projects/${projectSlug}`} class="block">
    <div class="flex items-start justify-between gap-2">
      <h3 class="text-copy-14 font-medium text-neutral-9">{name}</h3>
      {status && (
        <span class={`shrink-0 rounded-full px-2 py-px text-caption-10 font-medium ${statusColors[status] ?? 'text-neutral-7'}`}>
          {statusLabels[status] ?? status}
        </span>
      )}
    </div>

    {description && (
      <p class={`mt-2 text-label-12 text-neutral-7 ${compact ? 'line-clamp-2' : ''}`}>{description}</p>
    )}

    {!compact && stack.length > 0 && (
      <div class="mt-2 flex flex-wrap gap-1">
        {stack.map((s: string) => (
          <span class="rounded-full border border-neutral-3 px-1.5 py-px text-caption-10 text-neutral-7">
            {s}
          </span>
        ))}
      </div>
    )}

    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-caption-10">
      {tags.map((tag: string) => (
        <span class="text-neutral-7">#{tag}</span>
      ))}
    </div>

    {!compact && (
      <div class="mt-3 flex flex-wrap gap-3 text-caption-10">
        {repo && (
          <a href={repo} class="text-neutral-7 hover:text-neutral-9 transition" onclick="event.stopPropagation()">
            GitHub
          </a>
        )}
        {demo && (
          <a href={demo} class="text-neutral-7 hover:text-neutral-9 transition" onclick="event.stopPropagation()">
            Demo
          </a>
        )}
        {links.map((link: { label: string; href: string }) => (
          <a href={link.href} class="text-neutral-7 hover:text-neutral-9 transition" onclick="event.stopPropagation()">
            {link.label}
          </a>
        ))}
      </div>
    )}
  </a>
</article>
