---
import { siteConfig } from '../../lib/site-config';
const year = new Date().getFullYear();
---

<footer class="mx-auto mt-16 w-full max-w-5xl px-5 pb-10 md:px-8">
  <div class="rounded-2xl border border-neutral-3 bg-neutral-1 px-5 py-6">
    <p class="text-sm font-semibold">{siteConfig.title}</p>
    <p class="mt-2 text-sm text-neutral-7">{siteConfig.description}</p>
    <div class="mt-4 flex flex-wrap gap-4 text-sm">
      {siteConfig.social.map((item) => (
        <a class="text-neutral-7 transition hover:text-neutral-9" href={item.href}>{item.label}</a>
      ))}
      <a class="text-neutral-7 transition hover:text-neutral-9" href="/timeline">时光</a>
    </div>
    <p class="mt-4 text-xs text-neutral-7">© 2026-{year} {siteConfig.author}</p>
  </div>
</footer>
