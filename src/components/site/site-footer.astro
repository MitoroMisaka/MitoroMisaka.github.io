---
import { siteConfig } from '../../lib/site-config';
const year = new Date().getFullYear();
---

<footer class="mx-auto mt-16 w-full max-w-7xl px-4 lg:px-8 pb-10" data-hide-print>
  <div class="rounded-2xl border border-neutral-3 bg-neutral-1 px-6 py-8">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
      <!-- 左: 关于 -->
      <div>
        <p class="text-label-12 font-medium text-neutral-7 uppercase tracking-wider">关于</p>
        <ul class="mt-3 space-y-2">
          <li><a href="/about" class="text-label-12 text-neutral-7 transition hover:text-neutral-9">关于本站</a></li>
          <li><a href="/about" class="text-label-12 text-neutral-7 transition hover:text-neutral-9">关于我</a></li>
        </ul>
      </div>
      <!-- 中: 更多 -->
      <div>
        <p class="text-label-12 font-medium text-neutral-7 uppercase tracking-wider">更多</p>
        <ul class="mt-3 space-y-2">
          <li><a href="/projects" class="text-label-12 text-neutral-7 transition hover:text-neutral-9">项目</a></li>
          <li><a href="/garden" class="text-label-12 text-neutral-7 transition hover:text-neutral-9">Garden</a></li>
          <li><a href="/rss.xml" class="text-label-12 text-neutral-7 transition hover:text-neutral-9">RSS 订阅</a></li>
        </ul>
      </div>
      <!-- 右: 联系 -->
      <div>
        <p class="text-label-12 font-medium text-neutral-7 uppercase tracking-wider">联系</p>
        <ul class="mt-3 space-y-2">
          {siteConfig.social.map((item) => (
            <li><a href={item.href} class="text-label-12 text-neutral-7 transition hover:text-neutral-9">{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-6 border-t border-neutral-3 pt-4 flex flex-col items-center gap-3 md:flex-row md:justify-between">
      <p class="text-title-20 font-medium">{siteConfig.title}</p>
      <div class="flex items-center gap-4 text-label-12">
        <a class="text-neutral-7 transition hover:text-neutral-9" href="/newsletter">Newsletter</a>
        <a class="text-neutral-7 transition hover:text-neutral-9" href="/timeline">时光</a>
      </div>
    </div>

    <p class="mt-4 text-center text-caption-10 text-neutral-7">© 2026-{year} {siteConfig.author}</p>
    <p class="mt-2 text-center text-caption-10 text-neutral-7">Built with <a href="https://astro.build" class="link-underline">Astro</a> · Powered by <a href="https://github.com/Innei/Yohaku" class="link-underline">余白 / Yohaku</a></p>
  </div>
</footer>
