---
import { siteConfig } from '../../lib/site-config';
import ThemeToggle from '../ui/theme-toggle';
import PagefindSearch from '../ui/pagefind-search';
import MobileNav from '../site/mobile-nav';
---

<header class="mx-auto w-full max-w-5xl px-5 pt-6 md:px-8">
  <nav class="flex items-center justify-between rounded-2xl px-4 py-3 site-header-glass">
    <a href="/" class="text-sm font-semibold tracking-wide text-neutral-9">{siteConfig.title}</a>
    <div class="flex items-center gap-4">
      <ul class="hidden md:flex items-center gap-4 text-sm text-neutral-7">
        {siteConfig.nav.map((item) => (
          <li>
            <a class="transition hover:text-neutral-9" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
      <MobileNav client:load />
      <PagefindSearch client:load />
      <ThemeToggle client:load />
    </div>
  </nav>
</header>
