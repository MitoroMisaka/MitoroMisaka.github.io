---
import { siteConfig } from '../../lib/site-config';
import ThemeToggle from '../ui/theme-toggle';
import PagefindSearch from '../ui/pagefind-search';
import MobileNav from '../site/mobile-nav';
---

<header class="fixed top-0 left-0 right-0 z-9 h-[4.5rem] bg-[var(--bg-opacity)] backdrop-blur-[12px]" data-hide-print>
  <nav class="flex items-center justify-between max-w-7xl mx-auto px-4 lg:px-8 h-full">
    <a href="/" class="text-label-12 font-medium tracking-wide text-neutral-9">{siteConfig.title}</a>
    <div class="flex items-center gap-4">
      <ul class="hidden md:flex items-center gap-4 text-label-12 text-neutral-7">
        {siteConfig.nav.map((item) => (
          <li>
            <a class="transition hover:text-neutral-9" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
      <MobileNav client:load />
      <PagefindSearch client:load />
      <ThemeToggle client:load />
    </div>
  </nav>
</header>
