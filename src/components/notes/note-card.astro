---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../lib/content-helpers';

interface Props {
  note: CollectionEntry<'notes'>;
  showExcerpt?: boolean;
}

const { note, showExcerpt = true } = Astro.props;
const { slug, title, description, date, tags, mood, pinned } = note.data;
---

<article class="rounded-2xl border border-[var(--line)] bg-[var(--card)] px-5 py-4 transition hover:border-[var(--line-strong)]">
  <a href={`/notes/${slug}`} class="block">
    <div class="flex items-start justify-between gap-2">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          {pinned && <span class="shrink-0 rounded-full bg-[var(--brand)]/10 px-2 py-px text-[10px] font-medium text-[var(--brand)]">置顶</span>}
          {title ? (
            <h3 class="text-base font-medium text-[var(--fg)]">{title}</h3>
          ) : (
            <h3 class="text-base font-medium text-[var(--fg)] line-clamp-2">{slug}</h3>
          )}
        </div>
      </div>
      {mood && <span class="shrink-0 text-sm">{mood}</span>}
    </div>

    {showExcerpt && description && (
      <p class="mt-2 text-sm text-[var(--fg-muted)] line-clamp-2">{description}</p>
    )}

    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--fg-soft)]">
      <time>{formatDate(date)}</time>
      {tags.length > 0 && (
        <span class="flex flex-wrap gap-1.5">
          {tags.map((tag: string) => (
            <a
              href={`/tags/${tag}`}
              class="rounded-full border border-[var(--line)] px-1.5 py-px hover:text-[var(--fg)]"
              onclick="event.stopPropagation()"
            >
              #{tag}
            </a>
          ))}
        </span>
      )}
    </div>
  </a>
</article>
