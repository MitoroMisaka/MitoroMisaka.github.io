---
import { siteConfig } from '../lib/site-config';
import { getCanonicalUrl } from '../lib/seo';
import SiteHeader from '../components/site/site-header.astro';
import SiteFooter from '../components/site/site-footer.astro';
import AnalyticsTracker from '../components/analytics/tracker';
import Lightbox from '../components/ui/lightbox';
import SakuraParticles from '../components/fx/sakura-particles';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  variant?: 'note';
}

const { title, description, canonicalPath, variant } = Astro.props;
const canonicalUrl = canonicalPath ? getCanonicalUrl(canonicalPath) : getCanonicalUrl('/');
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function(){var t=localStorage.getItem('theme');if(t==='dark')document.documentElement.setAttribute('data-theme','dark');else if(t==='light')document.documentElement.setAttribute('data-theme','light')})();
    </script>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title={siteConfig.title} />
    <link rel="alternate" type="application/rss+xml" href="/notes.xml" title="静かな森 — 碎念" />
    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen bg-neutral-1 text-neutral-9 transition-colors duration-300">
      <div class="h-[4.5rem]"></div>
      <SiteHeader />
      <main class="mx-auto w-full max-w-7xl px-4 lg:px-8 py-10">
        <article class={`mx-auto max-w-3xl${variant === 'note' ? ' markdown--note' : ''}`}>
          <slot />
        </article>
      </main>
      <SiteFooter />
    </div>
    <AnalyticsTracker client:idle />
    <Lightbox client:idle />
    <SakuraParticles client:load />
    <script>
      (function(){
        var blocks = document.querySelectorAll('pre.mermaid');
        if (!blocks.length) return;
        // Detect current theme from data attribute or system preference
        var html = document.documentElement;
        var themeAttr = html.dataset.theme;
        var isDark = themeAttr === 'dark' || (!themeAttr && window.matchMedia('(prefers-color-scheme: dark)').matches);
        import('mermaid').then(function(mod){
          var m = mod.default || mod;
          m.initialize({
            startOnLoad: false,
            theme: isDark ? 'dark' : 'default',
            securityLevel: 'loose',
          });
          m.run({ nodes: Array.from(blocks) });
        }).catch(function(e){ console.warn('Mermaid:', e); });
      })();
    </script>
  </body>
</html>
