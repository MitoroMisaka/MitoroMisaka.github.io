---
import { siteConfig } from '../lib/site-config';
import { getCanonicalUrl } from '../lib/seo';
import SiteHeader from '../components/site/site-header.astro';
import SiteFooter from '../components/site/site-footer.astro';
import AnalyticsTracker from '../components/analytics/tracker';
import Lightbox from '../components/ui/lightbox';
import MermaidRenderer from '../components/ui/mermaid-renderer';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
const canonicalUrl = canonicalPath ? getCanonicalUrl(canonicalPath) : getCanonicalUrl('/');
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title={siteConfig.title} />
    <link rel="alternate" type="application/rss+xml" href="/notes.xml" title="静かな森 — 碎念" />
    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen bg-[var(--bg)] text-[var(--fg)] transition-colors duration-300">
      <SiteHeader />
      <main class="mx-auto w-full max-w-5xl px-5 py-10 md:px-8">
        <article class="mx-auto max-w-3xl">
          <slot />
        </article>
      </main>
      <SiteFooter />
    </div>
    <AnalyticsTracker client:idle />
    <Lightbox client:idle />
    <MermaidRenderer client:idle />
  </body>
</html>
