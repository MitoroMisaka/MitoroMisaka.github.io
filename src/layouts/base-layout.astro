---
import { siteConfig } from '../lib/site-config';
import SiteHeader from '../components/site/site-header.astro';
import SiteFooter from '../components/site/site-footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = siteConfig.title, description = siteConfig.description } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title={siteConfig.title} />
    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen bg-[var(--bg)] text-[var(--fg)] transition-colors duration-300">
      <SiteHeader />
      <main class="mx-auto w-full max-w-5xl px-5 py-10 md:px-8">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
